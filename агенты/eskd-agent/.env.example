# ESKD Agent — Docker Compose (модульный стек)
#
# cp .env.example .env && отредактируйте пути к модели
#
# Рекомендуемый запуск через ./stack.sh:
#   ./stack.sh up app --model-host --lan --build   # UI + backend, model на хосте
#   ./stack.sh up infra                            # только PostgreSQL
#   ./stack.sh up backend --model-host             # API без frontend
#   ./stack.sh up frontend --model-host --lan      # UI (поднимет backend)
#   ./stack.sh up model --build                    # GPU model в Docker
#   ./stack.sh up all --build                      # полный стек
#   ./stack.sh dev backend                         # backend с hot reload
#   ./stack.sh dev frontend --model-host           # Vite :5173
#   ./stack.sh debug backend                       # postgres:5432 + debug logs
#
# Быстрый старт (model на хосте + LAN):
#   ./start.sh
#
# Legacy (deprecated):
#   docker compose -f docker-compose.yml -f docker-compose.ui.yml up -d backend frontend

# HuggingFace (если base model скачивается с Hub)
HF_TOKEN=

# Пути к артефактам на хосте (монтируются в model-контейнер)
BASE_MODEL_PATH=../models/gemma-3n-e4b-hf
ADAPTER_PATH=../dist/kaggle_release/gemma-3n-eskd-lora

# Порты и bind (0.0.0.0 — доступ из локальной сети)
FRONTEND_PORT=3000
FRONTEND_LAN_PORT=8000
BACKEND_PORT=8080
POSTGRES_PORT=5432
BIND_ADDRESS=0.0.0.0

# Model на хосте (stack.sh --model-host): по умолчанию слушает 0.0.0.0:8765
MODEL_SERVICE_URL=http://host.docker.internal:8765

# CORS: * — любой origin; или перечислите URL через запятую
CORS_ORIGINS=*

# Порт model API на хосте (для LAN-проброса и debug-model)
MODEL_PORT=8765

# Лимиты
MAX_ITEMS=50
MAX_UPLOAD_MB=200

# Конвертеры чертежей (опционально)
# ODA_CONVERTER_PATH=/opt/ODAFileConverter/ODAFileConverter
# KOMPAS_EXPORT_CMD='wine KOMPAS.exe /export "{input}" "{png}"'

# GPU (all или 0)
NVIDIA_VISIBLE_DEVICES=all

# PostgreSQL (история проверок и разметка)
POSTGRES_USER=eskd
POSTGRES_PASSWORD=eskd
POSTGRES_DB=eskd_agent
DATABASE_URL=postgresql+asyncpg://eskd:eskd@postgres:5432/eskd_agent
STORAGE_PATH=/data/previews

# Integration layer
INTEGRATION_WORKER_ENABLED=true

# Two-stage ESKD pipeline (extract → rules → LLM eval)
# legacy = single-pass Gemma; two_stage = stage 2b через LLM (OpenRouter или LM Studio)
ESKD_PIPELINE_MODE=two_stage
# local = Gemma GPU; openrouter = cloud VLM; lmstudio = vision через LM Studio (Mistral/qwen3-vl)
ESKD_VLM_BACKEND=lmstudio
OPENROUTER_API_KEY=
# Stage 1 vision (LM Studio)
LM_STUDIO_VLM_BASE_URL=http://192.168.1.157:1234/v1
LM_STUDIO_VLM_MODEL=ministral-3-14b-instruct-2512
LM_STUDIO_VLM_FALLBACK_MODEL=qwen3-vl-8b-thinking
LM_STUDIO_VLM_TIMEOUT_SEC=600
# Legacy OpenRouter cloud VLM (если ESKD_VLM_BACKEND=openrouter)
OPENROUTER_VLM_MODEL=google/gemma-4-31b-it:free
OPENROUTER_VLM_TIMEOUT_SEC=180
# LLM eval (stage 2b): OpenRouter cloud или LM Studio Qwen на LAN
OPENROUTER_EVAL_MODEL=qwen/qwen3.5-9b
OPENROUTER_MODEL=qwen/qwen3.5-9b
OPENROUTER_BASE_URL=http://192.168.1.157:1234/v1

# Тестовые пользователи ОТК (seed в eskd_users + platform users):
# otk.timofeev, otk.ermakov, otk.voroshina, otk.babalykhyan, otk.sarkisyan,
# otk.gruntovskiy, otk.arsunov — email otk.<login>@example.com, пароль Test123!
# Регистрация platform: AIAgentBack/scripts/create_otk_test_users.py
# Авторизация UI: платформа http://192.168.1.157:5173/login → /agents/eskd
# ESKD API: X-Dev-User маппится из platform user (AUTH_MODE=dev)
AUTH_MODE=dev
DEV_DEFAULT_ROLES=ESKD_OTK

# Пропустить автозапуск model в start.sh (offline/cache режим)
# SKIP_MODEL_START=1

# Debug
# LOG_LEVEL=debug

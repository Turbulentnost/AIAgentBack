# ── Режим работы ───────────────────────────────────────────────
# dry_run — классификация и XML без записи в 1С (ТЗ §6)
# review  — низкая/средняя уверенность → очередь оператора
# live    — автоматическая регистрация при высокой уверенности
AGENT_MODE=live
USE_STUBS=false

# ── Qdrant (RAG) ───────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
# stub | qdrant — коллекции contractors / departments
RAG_BACKEND=qdrant
# Гибрид узла 5: правила → RAG fallback при низкой уверенности / конфликте / резерве
RAG_DEPARTMENT_ENABLED=true

# ── OData 1С → синхронизация RAG (scripts/sync_rag_from_1c.py --odata) ──
# ODATA_BASE_URL=http://server/erp/odata/standard.odata
# ODATA_USERNAME=
# ODATA_PASSWORD=
# ODATA_CONTRACTORS_ENTITY=Catalog_КонтрагентыForMail
# ODATA_DEPARTMENTS_ENTITY=Catalog_ПодразделенияForMail

# ── OData → запись документа «Входящая корреспонденция» (узел 7) ──
# ERP_MODE=odata          # odata | http | stub (приоритетнее USE_ODATA_ERP)
# USE_ODATA_ERP=true      # shorthand: OData если задан ODATA_BASE_URL
# ODATA_INCOMING_DOC_ENTITY=Document_ТД_ВходящаяКорреспонденция
# ODATA_TIMEOUT_SEC=60
# ODATA_INCOMING_FIELD_MAP={"xml_result":"Комментарий","department_name":"Подразделение"}
# ODATA_INCOMING_EXTRA_FIELDS={"Posted":false}
# Код организации ТЗ (НП, АЛ, МГ…) → Ref_Key из Catalog_Организации
# ODATA_ORGANIZATION_KEYS={"НП":"00000000-0000-0000-0000-000000000001","АЛ":"…"}
# Код подразделения 1С (00-000076) → Ref_Key из Catalog_СтруктураПредприятия
# ODATA_DEPARTMENT_KEYS={"00-000076":"00000000-0000-0000-0000-000000000002"}
# ODATA_ROUTING_RULES_PATH=data/routing_rules.json

# ── LLM Gateway (OpenAI-compatible) ───────────────────────────
# LM Studio: http://192.168.1.157:1234/v1  model: qwen/qwen3.5-9b
# OpenRouter: https://openrouter.ai/api/v1  model: meta-llama/llama-3.3-70b-instruct:free
# На письмо: 1 POST /chat/completions (спам + отдел + обзор), после правил 2.1 — 0 LLM.
LLM_GATEWAY_URL=http://192.168.1.157:1234/v1
LLM_GATEWAY_API_KEY=
LLM_DEFAULT_MODEL=qwen/qwen3.5-9b

# ── Внешние сервисы (когда появятся на платформе) ──────────────
DOCUMENT_SERVICE_URL=
INTEGRATION_SERVICE_URL=
VAULT_ADDR=

# ── Параметры обработки (раздел 4 ТЗ) ──────────────────────────
IMAP_POLL_INTERVAL_SEC=10
SPAM_THRESHOLD=0.85           # >= порога → SPAM
SPAM_GRAY_ZONE_LOW=0.70       # [low, threshold) → серая зона → human-in-the-loop
# Доверенные домены отправителей (через запятую). Пусто = домены из MAILBOXES.
TRUSTED_SENDER_DOMAINS=turbo-don.ru
# true = для @turbo-don.ru не вызывать LLM-спам (только правила 2.1)
SPAM_SKIP_LLM_FOR_TRUSTED=true
DEPT_CONFIDENCE_MIN=0.70      # < порога → awaiting_human
MAX_ATTACHMENT_MB=25
# Локальный парсинг PDF/DOCX/XLSX/OCR (если DOCUMENT_SERVICE_URL пуст)
DOCUMENT_EXTRACT_MAX_CHARS=12000
DOCUMENT_EXTRACT_TOTAL_MAX_CHARS=30000
DOCUMENT_STORAGE_EXCERPT_CHARS=2000
# pip install -e ".[documents]"  — pymupdf, python-docx, openpyxl, pillow, pytesseract
SUMMARY_MAX_SENTENCES=5       # краткий обзор (узел 6), 3–5 по ТЗ
SUMMARY_MAX_CHARS=800         # макс. длина обзора для 1С

# ── Почтовые ящики (расширяемый список через запятую) ──────────
# Тест: test_ii@turbo-don.ru (логин testii). Прод: info@, pereadres@ — свои пароли.
MAILBOXES=test_ii@turbo-don.ru

# ── IMAP (раздел 5.1) — mail.turbo-don.ru:993 SSL ─────────────
IMAP_HOST=mail.turbo-don.ru
IMAP_PORT=993
IMAP_CONNECT_TIMEOUT_SEC=30
# Windows-логин домена (не всегда совпадает с адресом ящика)
IMAP_USERNAME=testii
IMAP_PASSWORD=
# Общий IMAP_PASSWORD для всех ящиков в MAILBOXES.
# Отдельно: IMAP_PASSWORD_TEST_II_TURBO_DON_RU, IMAP_PASSWORD_INFO_TURBO_DON_RU, …

# ── PostgreSQL ─────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://agent:agent@localhost:5433/agent_pochta

# ── RabbitMQ / Celery ──────────────────────────────────────────
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
# Параллелизм worker (docker compose: celery-worker)
CELERY_WORKER_CONCURRENCY=8

# Фоновая синхронизация остатков и спецификаций Aveon из 1С (Celery Beat, Europe/Moscow)
# Каждый час в :00, включая 00:00
ONEC_DAILY_SYNC_ENABLED=true
ONEC_SYNC_EVERY_HOURS=1
ONEC_SYNC_MINUTE=0

# Повторы 1С: 10 мин × 5 (ТЗ §5.2)
ERP_RETRY_MAX=5
ERP_RETRY_DELAY_SEC=600

# REST API агента (scripts/run_api.py)
API_HOST=0.0.0.0
API_PORT=8080
AGENT_VERSION=0.1.0

# ── Статистика / журнал change_events ─────────────────────────
# Каталог экспорта (volume ./data в docker)
STATS_EXPORT_DIR=data/stats
# Дополнительная копия в корень репозитория (docker: celery-beat → /app/repo_root)
# STATS_REPO_ROOT=/app/repo_root
STATS_START_TIME=2026-07-08 08:35:00
STATS_TIMEZONE=Europe/Moscow
# Интервал фонового экспорта celery-beat, сек
STATS_EXPORT_INTERVAL_SEC=600

# ── Доступ к UI (scripts/write_access_info.ps1 / run_access_info.cmd) ──
# PLATFORM_LOGIN_EMAIL=temp.nd@local.dev
# PLATFORM_LOGIN_PASSWORD=
# PLATFORM_API_HOST=192.168.2.225:5454
# FRONTEND_PORT=5173
# BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.2.225:5173
# LAN-тестирование Авион: run_aveon_lan_access.cmd → access-info-aveon.txt + firewall 5173/5454

# ── 1С OData ───────────────────────────────────────────────────
# ONEC_ODATA_URL=http://192.168.17.5/ERP2
# ONEC_ODATA_USER=odata.user
# ONEC_ODATA_PASSWORD=
# ONEC_ODATA_TIMEOUT=15

# ── Google Sheets (Авион, Service Account) ─────────────────────
# 1. Google Cloud Console → APIs & Services → Enable «Google Sheets API»
# 2. IAM → Service Accounts → Create → Keys → JSON
# 3. Google Sheets → Share → добавить client_email из JSON с правом «Просмотр»
# GOOGLE_SHEETS_SPREADSHEET_ID=1C3SsvZ8IcK68d-nVCwOCnb7lmIy7SA03t6_wmHoJDqA
# GOOGLE_SHEETS_SHEET_GID=295357731
# GOOGLE_SHEETS_SERVICE_ACCOUNT_FILE=/secrets/aveon-google-sheets.json
# GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=

# ── Обратная связь агента Авион ────────────────────────────────
# Письма уходят на FEEDBACK_RECIPIENT_EMAIL (фамилия/имя, текст, вложения).
# На Windows: отправка через установленный Outlook (без пароля в .env).
# Альтернатива: OUTLOOK_EMAIL + OUTLOOK_PASSWORD + OUTLOOK_SMTP_HOST.
FEEDBACK_RECIPIENT_EMAIL=sktb_razvitie5@turbo-don.ru
# OUTLOOK_EMAIL=
# OUTLOOK_PASSWORD=
OUTLOOK_SERVER=mail.turbo-don.ru
OUTLOOK_SMTP_HOST=mail.turbo-don.ru
OUTLOOK_SMTP_PORT=587
OUTLOOK_SMTP_TLS=true

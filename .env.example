# ── Режим работы ───────────────────────────────────────────────
# true  — использовать заглушки платформенных сервисов (автономный запуск)
# false — подключаться к реальным сервисам платформы (LLM Gateway, 1С, Qdrant…)
USE_STUBS=true

# ── Параметры обработки (раздел 4 ТЗ) ──────────────────────────
IMAP_POLL_INTERVAL_SEC=60
SPAM_THRESHOLD=0.85           # >= порога → SPAM
SPAM_GRAY_ZONE_LOW=0.70       # [low, threshold) → серая зона → human-in-the-loop
DEPT_CONFIDENCE_MIN=0.70      # < порога → awaiting_human
MAX_ATTACHMENT_MB=25

# ── Почтовые ящики (расширяемый список через запятую) ──────────
MAILBOXES=info@turbo-don.ru,pereadres@turbo-don.ru

# ── PostgreSQL ─────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://agent:agent@localhost:5432/agent_pochta

# ── Qdrant (RAG) ───────────────────────────────────────────────
QDRANT_URL=http://localhost:6333

# ── RabbitMQ / Celery ──────────────────────────────────────────
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//

# ── Внешние сервисы платформы (используются при USE_STUBS=false) ─
LLM_GATEWAY_URL=
DOCUMENT_SERVICE_URL=
INTEGRATION_SERVICE_URL=
VAULT_ADDR=

# Версия агента (пишется в каждую запись обработки)
AGENT_VERSION=0.1.0

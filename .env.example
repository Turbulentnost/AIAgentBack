# ── Режим работы ───────────────────────────────────────────────
# dry_run — классификация и XML без записи в 1С (ТЗ §6)
# review  — низкая/средняя уверенность → очередь оператора
# live    — автоматическая регистрация при высокой уверенности
AGENT_MODE=live
USE_STUBS=false

# ── Qdrant (RAG) ───────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
# stub | qdrant — коллекции contractors / departments
RAG_BACKEND=qdrant
# Гибрид узла 5: правила → RAG fallback при низкой уверенности / конфликте / резерве
RAG_DEPARTMENT_ENABLED=true

# ── OData 1С → синхронизация RAG (scripts/sync_rag_from_1c.py --odata) ──
# ODATA_BASE_URL=http://server/erp/odata/standard.odata
# ODATA_USERNAME=
# ODATA_PASSWORD=
# ODATA_CONTRACTORS_ENTITY=Catalog_КонтрагентыForMail
# ODATA_DEPARTMENTS_ENTITY=Catalog_ПодразделенияForMail

# ── OData → запись документа «Входящая корреспонденция» (узел 7) ──
# Только документ Document_ТД_ВходящаяКорреспонденция; задачи в Документообороте — вручную.
# ERP_MODE=odata
# USE_ODATA_ERP=true
# ODATA_BASE_URL=http://192.168.2.229:81/erp_pm/odata/standard.odata
# ODATA_USERNAME=odata.user
# ODATA_PASSWORD=
# ODATA_INCOMING_DOC_ENTITY=Document_ТД_ВходящаяКорреспонденция
# ODATA_ATTACHED_FILE_FIELD_MAP_FILE=data/odata_attached_file_field_map.json
# ODATA_ATTACH_FILES_ENABLED=true
# ODATA_FILE_VOLUME_KEY=21886495-364e-11ea-82f2-ac1f6b05524c
#
# Режим хранения присоединённых файлов (Catalog_ТД_ВходящаяКорреспонденцияПрисоединенныеФайлы):
#   database — байты в ИБ (Base64 POST или stream PUT; шаблон АЛ00-000760)
#   volume   — «ВТомахНаДиске»: метаданные OData + файл на UNC-томе 1С
# ODATA_FILE_STORAGE_MODE=database
#
# Pre-upload на том ДО OData POST (только при storage_mode=volume):
#   true  — agent-pochta пишет файл на ODATA_FILE_VOLUME_ROOT, затем POST метаданных
#           (как ручной drag-drop из Outlook в толстый клиент 1С)
#   false — stream PUT в ФайлХранилище после POST (не для MSG на томе)
# ODATA_FILE_VOLUME_PREUPLOAD=false
#
# UNC-корень тома 1С. Если пусто — читается из OData Catalog_ТомаХраненияФайлов
# (ПолныйПутьWindows / ПолныйПутьLinux). Требует ACL на запись для учётной записи
# agent-pochta / celery-worker на шару \\srv2\erp_file\ (или смонтированный том).
# ODATA_FILE_VOLUME_ROOT=\\\\srv2\\erp_file\\
#
# GUID пользователя 1С для Автор_Key присоединённого файла (fallback: Ответственный_Key из defaults)
# ODATA_FILE_AUTHOR_KEY опционален при minimal_payload (data/odata_attached_file_field_map.json)
# ODATA_FILE_AUTHOR_KEY=a5e55eea-3a0a-11f0-9679-6cb31113810c
# Локальный staging перед OData POST (аудит байт, round-trip отчёт; удаляется после успеха)
# ODATA_ATTACH_STAGING_ENABLED=true
# ODATA_ATTACH_STAGING_DIR=data/temp/erp_attach_staging
# ODATA_ATTACH_STAGING_DELETE_AFTER_SUCCESS=true
# ODATA_ATTACH_STAGING_KEEP_ON_FAILURE=true
# ODATA_TIMEOUT_SEC=60
# ODATA_INCOMING_EXTRA_FIELDS={"Posted":false}
# ODATA_INCOMING_DEFAULTS_FILE=data/odata_incoming_defaults.json
# Дефолты (ГрифДоступа_Key, Ответственный_Key, Posted): data/odata_incoming_defaults.json
# GUID-ключи: python scripts/export_odata_guid_keys.py
# ODATA_ORGANIZATION_KEYS_FILE=data/odata_organization_keys.json
# ODATA_DEPARTMENT_KEYS_FILE=data/odata_department_keys.json
# или inline JSON:
# ODATA_ORGANIZATION_KEYS={"НП":"…","АЛ":"…"}
# ODATA_DEPARTMENT_KEYS={"00-000076":"…"}
# ODATA_ROUTING_RULES_PATH=data/routing_rules.json
# DIALOG_RULES_PATH=data/dialog_rules.json
# Проверка: python scripts/create_incoming_odata.py --test --dry-run

# === When agent paused for env rework: stop api/celery-* containers and comment LLM_* / GIGACHAT_* / API_* in .env ===
# ── LLM Gateway ───────────────────────────────────────────────
# Провайдер: openai_compat | gigachat | deepseek | auto
# auto — DeepSeek при DEEPSEEK_API_KEY; иначе GigaChat при GIGACHAT_API_PERS; иначе OpenAI-compatible.
#
# DeepSeek API:
#   LLM_PROVIDER=deepseek
#   DEEPSEEK_API_KEY=<ключ из platform.deepseek.com>
#   DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
#   LLM_DEFAULT_MODEL=deepseek-chat
#
# GigaChat (физлица, scope GIGACHAT_API_PERS):
#   LLM_PROVIDER=gigachat
#   GIGACHAT_API_PERS=<Authorization key, base64 из developers.sber.ru/studio>
#   GIGACHAT_SCOPE=GIGACHAT_API_PERS
#   GIGACHAT_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
#   GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
#   GIGACHAT_VERIFY_SSL=false
#   LLM_DEFAULT_MODEL=GigaChat
#
# OpenAI-compatible (LM Studio / OpenRouter):
#   LLM_PROVIDER=openai_compat
#   LLM_GATEWAY_URL=http://192.168.1.157:1234/v1
#   LLM_GATEWAY_API_KEY=
#   LLM_DEFAULT_MODEL=qwen/qwen3.5-9b
#
# На письмо: 1 POST /chat/completions (спам + отдел + обзор), после правил 2.1 — 0 LLM.
LLM_PROVIDER=deepseek
LLM_GATEWAY_URL=
LLM_GATEWAY_API_KEY=
LLM_DEFAULT_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
GIGACHAT_API_PERS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_VERIFY_SSL=false

# ── Внешние сервисы (когда появятся на платформе) ──────────────
DOCUMENT_SERVICE_URL=
INTEGRATION_SERVICE_URL=
VAULT_ADDR=

# ── Параметры обработки (раздел 4 ТЗ) ──────────────────────────
# Для нескольких ящиков (info@ + test_ii@) лучше 60 с, чтобы catch-up не упирался в soft limit.
IMAP_POLL_INTERVAL_SEC=10
IMAP_CATCHUP_DAYS=7
# Макс. писем за один catch-up цикл (заголовки + тела). Для info@ держите 30–50.
IMAP_CATCHUP_MAX_UIDS=50
SPAM_THRESHOLD=0.85           # >= порога → SPAM
SPAM_GRAY_ZONE_LOW=0.70       # [low, threshold) → серая зона → human-in-the-loop
# Доверенные домены отправителей (через запятую). Пусто = домены из MAILBOXES.
TRUSTED_SENDER_DOMAINS=turbo-don.ru
# true = для @turbo-don.ru не вызывать LLM-спам (только правила 2.1)
SPAM_SKIP_LLM_FOR_TRUSTED=true
DEPT_CONFIDENCE_MIN=0.70      # < порога → awaiting_human (обычные отделы)
DEPT_CONFIDENCE_CHAIRMAN_MIN=0.98   # Председатель СД (00-000001)
DEPT_CONFIDENCE_OD_MIN=0.95         # Операционный директор (00-000152)
DEPT_CONFIDENCE_VED_MIN=0.90        # ВЭД (00-000015) + обязателен hard foreign
MAX_ATTACHMENT_MB=25
# Таймаут IMAP при скачивании вложений (полный RFC822; по умолчанию 120 с)
IMAP_DOWNLOAD_TIMEOUT_SEC=120
# Локальный парсинг PDF/DOCX/XLSX/OCR (если DOCUMENT_SERVICE_URL пуст)
DOCUMENT_EXTRACT_MAX_CHARS=12000
DOCUMENT_EXTRACT_TOTAL_MAX_CHARS=30000
DOCUMENT_STORAGE_EXCERPT_CHARS=2000
# pip install -e ".[documents]"  — pymupdf, python-docx, openpyxl, pillow, pytesseract
SUMMARY_MAX_SENTENCES=5       # краткий обзор (узел 6), 3–5 по ТЗ
SUMMARY_MAX_CHARS=800         # макс. длина обзора для 1С

# ── Почтовые ящики (расширяемый список через запятую) ──────────
# Каждый адрес опрашивается отдельным IMAP-логином. Без IMAP_USER_* / IMAP_PASSWORD_*
# для ящика poller подключится с глобальным IMAP_USERNAME (ошибочно прочитает другой INBOX).
# Тест: test_ii@turbo-don.ru (логин testii). Прод: info@, pereadres@ — свои креды ниже.
MAILBOXES=test_ii@turbo-don.ru,info@turbo-don.ru

# ── IMAP (раздел 5.1) — mail.turbo-don.ru:993 SSL ─────────────
IMAP_HOST=mail.turbo-don.ru
IMAP_PORT=993
IMAP_CONNECT_TIMEOUT_SEC=30
# On-demand вложения в UI: кэш и частичный IMAP BODY.PEEK[part] вместо полного RFC822.
ATTACHMENT_CACHE_TTL_SEC=1800
ATTACHMENT_CACHE_MAX_MB=256
ATTACHMENT_IMAP_PARTIAL_FETCH=true
# См. также IMAP_DOWNLOAD_TIMEOUT_SEC выше (для GET .../attachments/{index})
# Общий fallback-логин/пароль (если для ящика нет IMAP_USER_* / IMAP_PASSWORD_* ниже):
IMAP_USERNAME=testii
IMAP_PASSWORD=
# Per-mailbox креды: имя = IMAP_USER_{MAILBOX}, где @ . - → _
#   info@turbo-don.ru     → IMAP_USER_INFO_TURBO_DON_RU / IMAP_PASSWORD_INFO_TURBO_DON_RU
#   test_ii@turbo-don.ru  → IMAP_USER_TEST_II_TURBO_DON_RU / IMAP_PASSWORD_TEST_II_TURBO_DON_RU
#   pereadres@turbo-don.ru → IMAP_USER_PEREADRES_TURBO_DON_RU / IMAP_PASSWORD_PEREADRES_TURBO_DON_RU
IMAP_USER_TEST_II_TURBO_DON_RU=testii
IMAP_PASSWORD_TEST_II_TURBO_DON_RU=
IMAP_USER_INFO_TURBO_DON_RU=info
IMAP_PASSWORD_INFO_TURBO_DON_RU=

# ── PostgreSQL ─────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://agent:agent@localhost:5433/agent_pochta

# ── RabbitMQ / Celery ──────────────────────────────────────────
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
# Параллелизм celery-worker. Для одного локального LLM (LM Studio) держите 2–4.
# При concurrency=8 легко получить шторм HTTP 400/ReadTimeout и «призрачные» unacks.
CELERY_WORKER_CONCURRENCY=3

# Повторы 1С: 10 мин × 5 (ТЗ §5.2). Задача rate_limit=6/m, чтобы не забить пул.
ERP_RETRY_MAX=5
ERP_RETRY_DELAY_SEC=600

# Диагностика «зависаний» celery-worker (ghost unacks / ETA):
#   docker compose exec rabbitmq rabbitmqctl list_queues name messages_ready messages_unacknowledged
#   docker compose exec celery-worker celery -A agent_pochta.workers.celery_app:celery_app inspect active
#   docker compose exec celery-worker celery -A agent_pochta.workers.celery_app:celery_app inspect scheduled
# Симптом hang: unacknowledged > 0 на celery, а active И scheduled пустые → restart worker.
# Если scheduled полон retry_erp с eta — смотрите очередь erp (celery-erp-worker), не celery.

# REST API агента (scripts/run_api.py)
API_HOST=0.0.0.0
API_PORT=8080
AGENT_VERSION=0.1.0

# ── Статистика / журнал change_events ─────────────────────────
# Каталог экспорта (volume ./data в docker)
STATS_EXPORT_DIR=data/stats
# Дополнительная копия в корень репозитория (docker: celery-beat → /app/repo_root)
# STATS_REPO_ROOT=/app/repo_root
STATS_START_TIME=2026-07-08 08:35:00
STATS_TIMEZONE=Europe/Moscow
# Интервал фонового экспорта celery-beat, сек
STATS_EXPORT_INTERVAL_SEC=600
# Резервная синхронизация HITL JSON/PG → Qdrant (celery-beat), сек
RAG_SYNC_INTERVAL_SEC=3600

# ── Prometheus / Grafana (docker compose: prometheus, grafana) ──
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
# GRAFANA_ADMIN_PASSWORD=admin

# ── Доступ к UI (scripts/write_access_info.ps1 / run_access_info.cmd) ──
# PLATFORM_LOGIN_EMAIL=temp.nd@local.dev
# PLATFORM_LOGIN_PASSWORD=
# Хост платформы agent_nd (auth /api/v1/auth/login), не agent-pochta :8080.
# Должен быть доступен с ПК разработчика; см. VITE_API_PROXY в agent_nd_front/.env
# PLATFORM_API_HOST=192.168.1.157:5454
# FRONTEND_PORT=5173

# ── Веб-поиск поставщиков (менеджер закупок) ───────────────────
# PROCUREMENT_WEB_ADAPTER=browser
# auto: HTTP DuckDuckGo SERP first, then Edge/Chrome, then Yandex
# PROCUREMENT_WEB_SEARCH_PROVIDER=auto
# PROCUREMENT_WEB_SEARCH_ENGINE=bing
# PROCUREMENT_WEB_HTTP_SEARCH_ENGINE=duckduckgo
# PROCUREMENT_WEB_BROWSER_PATH=
# PROCUREMENT_WEB_BROWSER_PREFER=edge
# PROCUREMENT_WEB_BROWSER_TIMEOUT_SECONDS=60
# PROCUREMENT_WEB_HTTP_TIMEOUT_SECONDS=20
# PROCUREMENT_MANAGER_SEARCH_TIMEOUT_SECONDS=180
# PROCUREMENT_MANAGER_WEB_SEARCH_TIMEOUT_SECONDS=300
# PROCUREMENT_WEB_QWEN_AGENT=true
# PROCUREMENT_WEB_QWEN_AGENT_MAX_PAGES=3
# PROCUREMENT_WEB_QWEN_AGENT_CONCURRENCY=2
# PROCUREMENT_WEB_QWEN_AGENT_BUDGET_SECONDS=45
# PROCUREMENT_MANAGER_INTERNAL_SUPPLIER_THRESHOLD=1

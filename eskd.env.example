# ESKD Agent — env для docker-compose (скопируйте: cp eskd.env.example eskd.env)
# Model API на хосте: py eskd_model_api.py --host 0.0.0.0 --port 8765 (из agent_nd/агенты/eskd-agent/model)

ESKD_BACKEND_PORT=8080
ESKD_POSTGRES_USER=eskd
ESKD_POSTGRES_PASSWORD=eskd
ESKD_POSTGRES_DB=eskd_agent
ESKD_MODEL_SERVICE_URL=http://host.docker.internal:8765

CORS_ORIGINS=*
MAX_UPLOAD_MB=200
AUTH_MODE=dev
DEV_DEFAULT_ROLES=ESKD_OTK
INTEGRATION_WORKER_ENABLED=true

# VLM (vision): основной → fallback при ошибке/таймауте на изображениях
# legacy = v1: один VLM-промпт на лист; two_stage = VLM extract + 8 LLM; per_gost = v2 (UI)
# Polza (OpenAI-compatible): https://polza.ai/api/v1 + ESKD_API_KEY (Bearer)
ESKD_PIPELINE_MODE=per_gost
ESKD_VLM_BACKEND=openrouter
LM_STUDIO_VLM_BASE_URL=https://polza.ai/api/v1
LM_STUDIO_VLM_MODEL=qwen/qwen3-vl-235b-a22b-instruct
LM_STUDIO_VLM_FALLBACK_MODEL=
LM_STUDIO_VLM_TIMEOUT_SEC=600
ESKD_API_KEY=
OPENROUTER_EVAL_MODEL=qwen/qwen3.5-9b
OPENROUTER_MODEL=qwen/qwen3.5-9b
OPENROUTER_BASE_URL=http://192.168.1.157:1234/v1
ESKD_LLM_RETRY_MAX=5
ESKD_LLM_RETRY_DELAY_SEC=25
ESKD_LLM_RETRY_MAX_DELAY_SEC=180
ESKD_LLM_QUEUE_ROUNDS=2
ESKD_VLM_RETRY_MAX=5
ESKD_VLM_RETRY_DELAY_SEC=30
ESKD_GOST_DELAY_SEC=12
ESKD_POST_VLM_DELAY_SEC=20
ESKD_HEALTH_PROBE_TIMEOUT_SEC=4
ESKD_HEALTH_CACHE_SEC=300

////////////////////////////////////////////////////////////////////////////////
// Исправление расширения ТД_ВходящаяКорреспонденцияПрисоединенныеФайлы
//
// ПРОБЛЕМА (НП00-003921 Ref 10e07d21…):
//   После «успешного» BSP: Base64 очищен, ТипХраненияФайла=ВТомахНаДиске,
//   но Том_Key пустой и ПутьКФайлу="" → байты нигде → «Данные файла недоступны».
//
// ПРИЧИНЫ:
//   1) &После("ПередЗаписью") — ОбменДанными.Загрузка уже Ложь → старая
//      ТребуетсяОбработкаOData могла не сработать (или сработала частично).
//   2) ДозаполнитьМетаданныеФайла ставит тип «В томах» через
//      РаботаСФайламиСлужебный.ТипХраненияФайла, а ЗаписатьДвоичныеДанные…
//      не создаёт файл на томе / не заполняет Том+Путь.
//   3) ОчиститьПолеОбмена вызывается БЕЗ проверки, что файл реально в БСП —
//      единственная копия байтов уничтожается.
//
// ЧТО СДЕЛАТЬ В КОНФИГУРАТОРЕ:
//   Заменить модуль объекта расширения на код ниже (целиком процедуры).
//   Обязательно: &Перед("ПередЗаписью"), не &После.
////////////////////////////////////////////////////////////////////////////////

// --- подписки ---

&Перед("ПередЗаписью")
Процедура РасшERP_ПередЗаписью(Отказ)
	ПодготовитьЗагрузкуИзOData(ЭтотОбъект);
КонецПроцедуры

&После("ПриЗаписи")
Процедура РасшERP_ПриЗаписи(Отказ)
	ЗавершитьЗагрузкуИзOData(ЭтотОбъект);
КонецПроцедуры

// --- подготовка / завершение ---

Процедура ПодготовитьЗагрузкуИзOData(ОбъектФайла)

	Если ОбъектФайла.ДополнительныеСвойства.Свойство("ODataФайлОбработан") Тогда
		Возврат;
	КонецЕсли;

	Если Не ТребуетсяОбработкаOData(ОбъектФайла) Тогда
		Возврат;
	КонецЕсли;

	ДвоичныеДанные = ПолучитьДвоичныеДанныеИзПоляОбмена(ОбъектФайла);
	Если ДвоичныеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ДозаполнитьМетаданныеФайла(ОбъектФайла, ДвоичныеДанные);
	ОбъектФайла.ДополнительныеСвойства.Вставить("ODataДвоичныеДанные", ДвоичныеДанные);
	ОбъектФайла.ДополнительныеСвойства.Вставить("ODataТребуетсяЗавершение", Истина);

КонецПроцедуры

Процедура ЗавершитьЗагрузкуИзOData(ОбъектФайла)

	Если ОбъектФайла.ДополнительныеСвойства.Свойство("ODataФайлОбработан") Тогда
		Возврат;
	КонецЕсли;

	Если Не ОбъектФайла.ДополнительныеСвойства.Свойство("ODataТребуетсяЗавершение") Тогда
		Возврат;
	КонецЕсли;

	ДвоичныеДанные = Неопределено;
	ОбъектФайла.ДополнительныеСвойства.Свойство("ODataДвоичныеДанные", ДвоичныеДанные);
	Если ДвоичныеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ЗаписатьДвоичныеДанныеВХранилищеБСП(ОбъектФайла.Ссылка, ДвоичныеДанные);

		// КРИТИЧНО: не очищать Base64, пока байты реально не в БСП/на томе.
		Если Не ФайлУжеВХранилище(ОбъектФайла.Ссылка) Тогда
			ВызватьИсключение
				"OData: после ЗаписатьДвоичныеДанныеВХранилищеБСП файл недоступен через РаботаСФайлами.ДвоичныеДанныеФайла (Том/Путь или регистр ИБ пусты). Base64 НЕ очищен.";
		КонецЕсли;

		Если Не ХранениеФайлаКорректно(ОбъектФайла.Ссылка) Тогда
			ВызватьИсключение
				"OData: ТипХранения=ВТомахНаДиске, но Том или ПутьКФайлу пусты после записи БСП. Base64 НЕ очищен.";
		КонецЕсли;

		ОчиститьПолеОбмена(ОбъектФайла.Ссылка);
		ОбъектФайла.ДополнительныеСвойства.Вставить("ODataФайлОбработан", Истина);

	Исключение
		ЗаписьЖурналаРегистрации(
			"OData.Прикрепление файла",
			УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Справочники.ТД_ВходящаяКорреспонденцияПрисоединенныеФайлы,
			ОбъектФайла.Ссылка,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

Функция ТребуетсяОбработкаOData(ОбъектФайла)

	Если ОбъектФайла.ДополнительныеСвойства.Свойство("ODataФайлОбработан") Тогда
		Возврат Ложь;
	КонецЕсли;

	// НЕ требовать ОбменДанными.Загрузка и ЗагрузкаЧерезOData:
	// при OData к моменту обработчика Загрузка часто уже Ложь.
	Если ФайлУжеВХранилище(ОбъектФайла.Ссылка) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ПолучитьДвоичныеДанныеИзПоляОбмена(ОбъектФайла) <> Неопределено;

КонецФункции

Функция ПолучитьДвоичныеДанныеИзПоляОбмена(ОбъектФайла)

	Если Не ЗначениеЗаполнено(ОбъектФайла.ФайлХранилище) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ДвоичныеДанные = ОбъектФайла.ФайлХранилище.Получить();
	Если ДвоичныеДанные = Неопределено Или ДвоичныеДанные.Размер() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ДвоичныеДанные;

КонецФункции

Функция ФайлУжеВХранилище(СсылкаНаФайл)

	Если Не ЗначениеЗаполнено(СсылкаНаФайл) Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка
		ДвоичныеДанные = РаботаСФайлами.ДвоичныеДанныеФайла(СсылкаНаФайл, Ложь);
		Возврат ДвоичныеДанные <> Неопределено И ДвоичныеДанные.Размер() > 0;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

Функция ХранениеФайлаКорректно(СсылкаНаФайл)

	Если Не ЗначениеЗаполнено(СсылкаНаФайл) Тогда
		Возврат Ложь;
	КонецЕсли;

	ОбъектФайла = СсылкаНаФайл.ПолучитьОбъект();
	Если ОбъектФайла = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ОбъектФайла.ТипХраненияФайла = Перечисления.ТипыХраненияФайлов.ВТомахНаДиске Тогда
		Возврат ЗначениеЗаполнено(ОбъектФайла.Том)
			И ЗначениеЗаполнено(ОбъектФайла.ПутьКФайлу);
	КонецЕсли;

	// ВИнформационнойБазе — достаточно ФайлУжеВХранилище (проверяется отдельно).
	Возврат Истина;

КонецФункции

Процедура ДозаполнитьМетаданныеФайла(ОбъектФайла, ДвоичныеДанные)

	Если Не ЗначениеЗаполнено(ОбъектФайла.Размер) Тогда
		ОбъектФайла.Размер = ДвоичныеДанные.Размер();
	КонецЕсли;

	// Для OData принудительно ИБ: запись в том из REST часто даёт
	// ТипХранения=ВТомахНаДиске без Том/Путь (файл «есть», байтов нет).
	// Если агент уже прислал заполненные Том+Путь — оставляем том.
	ЕстьТомИПуть = ЗначениеЗаполнено(ОбъектФайла.Том)
		И ЗначениеЗаполнено(ОбъектФайла.ПутьКФайлу);

	Если Не ЕстьТомИПуть Тогда
		ОбъектФайла.ТипХраненияФайла = Перечисления.ТипыХраненияФайлов.ВИнформационнойБазе;
	ИначеЕсли Не ЗначениеЗаполнено(ОбъектФайла.ТипХраненияФайла) Тогда
		ОбъектФайла.ТипХраненияФайла = Перечисления.ТипыХраненияФайлов.ВТомахНаДиске;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ОбъектФайла.Изменил) Тогда
		ОбъектФайла.Изменил = Пользователи.АвторизованныйПользователь();
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ОбъектФайла.ДатаСоздания) Тогда
		ОбъектФайла.ДатаСоздания = ТекущаяДатаСеанса();
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ОбъектФайла.ДатаМодификацииУниверсальная) Тогда
		ОбъектФайла.ДатаМодификацииУниверсальная = ТекущаяУниверсальнаяДата();
	КонецЕсли;

КонецПроцедуры

Процедура ЗаписатьДвоичныеДанныеВХранилищеБСП(СсылкаНаФайл, ДвоичныеДанные)

	АдресВременногоХранилища = ПоместитьВоВременноеХранилище(
		ДвоичныеДанные, Новый УникальныйИдентификатор);

	ОбъектФайла = СсылкаНаФайл.ПолучитьОбъект();

	// Ещё раз зафиксировать ИБ, если том/путь пусты (защита от гонки).
	Если Не (ЗначениеЗаполнено(ОбъектФайла.Том) И ЗначениеЗаполнено(ОбъектФайла.ПутьКФайлу)) Тогда
		ОбъектФайла.ТипХраненияФайла = Перечисления.ТипыХраненияФайлов.ВИнформационнойБазе;
	КонецЕсли;

	Контекст = РаботаСФайламиСлужебный.КонтекстОбновленияФайла(
		ОбъектФайла,
		АдресВременногоХранилища,
		СсылкаНаФайл);

	МенеджерФайла = РаботаСФайламиСлужебный.МенеджерФайлов(ОбъектФайла);
	МенеджерФайла.ПередОбновлениемДанныхФайла(Контекст);
	МенеджерФайла.ПередЗаписьюДанныхФайла(Контекст, ОбъектФайла);
	МенеджерФайла.ПриОбновленииДанныхФайла(Контекст, СсылкаНаФайл);
	МенеджерФайла.ПослеОбновленияДанныхФайла(Контекст, Истина);

	// Перечитать и дописать размер/тип, если менеджер изменил объект в памяти.
	ОбъектФайла = СсылкаНаФайл.ПолучитьОбъект();
	Если ОбъектФайла.Размер <> ДвоичныеДанные.Размер() Тогда
		ОбъектФайла.Размер = ДвоичныеДанные.Размер();
	КонецЕсли;

	ОбъектФайла.ДополнительныеСвойства.Вставить("ODataФайлОбработан", Истина);
	ОбъектФайла.ОбменДанными.Загрузка = Истина;
	ОбъектФайла.Записать();

КонецПроцедуры

Процедура ОчиститьПолеОбмена(СсылкаНаФайл)

	ОбъектФайла = СсылкаНаФайл.ПолучитьОбъект();
	Если Не ЗначениеЗаполнено(ОбъектФайла.ФайлХранилище) Тогда
		Возврат;
	КонецЕсли;

	ОбъектФайла.ФайлХранилище = Неопределено;
	ОбъектФайла.ДополнительныеСвойства.Вставить("ODataФайлОбработан", Истина);
	ОбъектФайла.ОбменДанными.Загрузка = Истина;
	ОбъектФайла.Записать();

КонецПроцедуры

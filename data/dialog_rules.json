{
  "version": "1.0",
  "description": "Категория «Диалог»: переписка без явного поручения. Правила обновляются без изменения кода.",
  "enabled": true,
  "document_kind": "dialog",
  "dormant_status": "dialog",
  "dormant_theme_action": "Диалог",
  "dormant_process_type": "ознакомление",
  "register_erp_dormant": false,
  "register_erp_activated": true,
  "queue_tier_dormant": 2,
  "queue_tier_activated": 1,
  "exclude_if_claim": true,
  "exclude_if_obligation": true,
  "exclude_process_types": ["исполнение"],
  "thread_markers": {
    "subject_prefixes": [
      "re:",
      "fw:",
      "fwd:",
      "ответ:",
      "пересл:",
      "пересылка:"
    ],
    "body_patterns": [
      "пишет:",
      " wrote:",
      "отправлено:",
      "original message",
      "исходное сообщение",
      "---------- переслан",
      "---------- forwarded",
      "> ",
      "в ответ на ваше",
      "в ответ на письмо"
    ],
    "min_thread_signals": 1
  },
  "company_thread_signals": {
    "patterns": [
      "турбулентность-дон",
      "турбулентность дон",
      "турбулентность"
    ],
    "min_occurrences": 2,
    "allow_exchange_markers": true,
    "allow_dormant_markers": true
  },
  "body_top": {
    "max_lines": 12,
    "max_chars": 600,
    "quote_line_prefixes": [
      ">",
      "пишет:",
      " wrote:",
      "отправлено:",
      "original message",
      "исходное сообщение",
      "---------- переслан",
